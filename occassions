<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="description" content="Celebrate at Savora Avenue with VIP dinners, birthday specials, digital gift cards and private occasion bookings.">
  <title>Occasions | Savora Avenue</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Great+Vibes&family=Hanken+Grotesk:wght@400;500;700&display=swap" rel="stylesheet">
  <style>
    :root{
      --pine:#27243f;--pine-2:#34304e;--saffron:#aa4d39;--paper:#f3ead8;
      --ink:#f3ead8;--mute:#d3c8b7;--serif:'Times New Roman',Georgia,serif;
      --sans:'Hanken Grotesk',system-ui,-apple-system,'Segoe UI',sans-serif;
      --olive:#111321;--gold-light:#df896c;--dark-ink:#111321;
    }
    *{box-sizing:border-box;margin:0;padding:0}
    html{scroll-behavior:smooth;scroll-padding-top:24px}
    body{font-family:var(--sans);color:var(--ink);background:var(--olive);line-height:1.7;font-size:17px}
    a{color:inherit}
    :focus-visible{outline:3px solid var(--gold-light);outline-offset:3px}
    .wrap{max-width:1160px;margin:0 auto;padding:0 28px}
    header{background:var(--pine);color:var(--paper);border-bottom:1px solid rgba(198,107,82,.35)}
    nav{display:flex;align-items:center;justify-content:space-between;padding:25px 0;gap:20px}
    .logo{position:relative;display:inline-flex;flex:0 0 auto;line-height:0;text-decoration:none}
    .logo img{display:block;width:150px;height:100px;object-fit:contain;transition:transform .25s ease,filter .25s ease}
    .logo-part{position:absolute;z-index:2;border:0;background:transparent;cursor:pointer}
    .logo-smoke{left:50%;top:3%;width:25%;height:24%;transform:translateX(-50%)}
    .logo-utensils{left:41%;top:38%;width:22%;height:17%}
    .logo-smoke::before,.logo-smoke::after{content:"";position:absolute;bottom:-5%;width:30%;height:82%;border-radius:52% 48% 50% 50%;border-left:2px solid rgba(255,248,224,.92);border-top:1px solid rgba(255,248,224,.28);filter:blur(1px);opacity:0;pointer-events:none}
    .logo-smoke::before{left:27%;animation:smoke-drift 2.4s ease-in-out infinite}
    .logo-smoke::after{right:22%;height:68%;animation:smoke-drift 2.8s .55s ease-in-out infinite}
    .logo-utensils::before,.logo-utensils::after{content:none}
    .logo:has(.logo-utensils:hover) img{animation:utensils-wiggle .65s ease-in-out infinite alternate;filter:brightness(1.1) drop-shadow(0 5px 8px rgba(223,137,108,.22))}
    @keyframes smoke-drift{0%{transform:translate(3px,10px) scale(.65) rotate(-12deg);opacity:0}20%{opacity:.85}55%{transform:translate(-5px,-5px) scale(.9) rotate(9deg)}100%{transform:translate(7px,-22px) scale(1.2) rotate(-6deg);opacity:0}}
    @keyframes utensils-wiggle{from{transform:rotate(-1deg) translateY(1px)}to{transform:rotate(1deg) translateY(-2px)}}
    nav ul{display:flex;gap:28px;list-style:none;align-items:center}
    nav ul a{text-decoration:none;font-weight:500;font-size:.9rem;letter-spacing:.04em}
    nav ul a:not(.btn){color:var(--ink)}
    nav ul a:not(.btn):hover,nav ul a[aria-current="page"]{color:var(--gold-light)}
    .btn{display:inline-block;background:var(--saffron);color:var(--paper);font-weight:700;text-decoration:none;padding:13px 24px;border-radius:2px;border:1px solid var(--saffron);letter-spacing:.06em;text-transform:uppercase;transition:background .2s,border-color .2s,color .2s}
    .btn:hover{background:#903e2d;border-color:#903e2d;color:var(--paper)}
    .btn.ghost{background:transparent;color:var(--ink);border-color:rgba(198,107,82,.75)}
    .btn.ghost:hover{border-color:var(--gold-light);color:var(--gold-light)}
    .hero{padding:76px 0 84px;background:radial-gradient(ellipse at 18% 48%,var(--pine-2) 0%,var(--pine) 70%)}
    .hero .wrap{display:grid;grid-template-columns:1fr .95fr;gap:68px;align-items:center}
    .eyebrow{color:var(--gold-light);font-size:.78rem;font-weight:700;letter-spacing:.2em;text-transform:uppercase}
    h1,.section-title{font-family:var(--serif);font-weight:700;color:var(--ink);line-height:1.12}
    h1{max-width:12ch;margin-top:12px;font-size:clamp(3.2rem,6vw,5.3rem)}
    .hero-copy{max-width:48ch;margin:22px 0 30px;color:var(--mute);font-size:1.1rem}
    .hero-actions{display:flex;gap:14px;flex-wrap:wrap}
    .hero-photo{position:relative;min-height:420px;margin:0}
    .hero-photo img,.occasion-photo img{display:block;width:100%;height:100%;object-fit:cover}
    .hero-photo img{position:absolute;inset:0;border:1px solid rgba(198,107,82,.65);box-shadow:14px 14px 0 rgba(18,22,14,.32)}
    .photo-note{position:absolute;right:-14px;bottom:22px;max-width:230px;padding:17px 20px;background:var(--paper);color:#27243f;font-family:var(--serif);font-size:1.05rem;line-height:1.4;box-shadow:0 8px 24px rgba(18,22,14,.2)}
    section{padding:82px 0}
    .offerings{background:var(--olive)}
    .section-heading{max-width:700px;margin:0 auto 40px;text-align:center}
    .section-title{margin-top:8px;font-size:clamp(2.4rem,4vw,3.5rem)}
    .section-heading>p:last-child{margin:14px auto 0;color:var(--mute)}
    .occasion-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:24px}
    .occasion-card{overflow:hidden;background:var(--pine);border:1px solid rgba(198,107,82,.45)}
    .occasion-photo{height:290px;position:relative;margin:10px 10px 0}
    .occasion-photo img{border:1px solid rgba(198,107,82,.5)}
    .occasion-copy{padding:22px 24px 26px}
    .occasion-copy h3{margin-top:5px;font-family:var(--serif);font-size:1.65rem;line-height:1.2}
    .occasion-copy p{margin:10px 0 18px;color:var(--mute)}
    .host{background:var(--pine);border-top:1px solid rgba(198,107,82,.3);border-bottom:1px solid rgba(198,107,82,.3)}
    .host .section-heading{margin-bottom:34px}
    .host .section-heading>p:last-child{color:var(--mute)}
    .host-grid{display:grid;grid-template-columns:1fr;gap:34px;max-width:760px;margin:0 auto}
    .host-copy h3{font-family:var(--serif);font-size:1.6rem;line-height:1.25}
    .host-copy{max-width:65ch;margin:0 auto;text-align:center}
    .host-copy p{margin-top:14px;color:var(--mute)}
    .host-copy ul{margin:20px 0 0;color:var(--mute);list-style:none}
    .host-copy li{padding:4px}
    .booking-form{position:relative;display:grid;gap:14px;padding:26px;background:var(--paper);color:var(--dark-ink);border:1px solid var(--gold-light);box-shadow:0 18px 45px rgba(18,22,14,.22)}
    .booking-form h3{font-family:var(--serif);font-size:1.6rem;line-height:1.2;text-align:center}
    .form-intro{margin-top:-7px;color:#514d5f;font-size:.92rem}
    .form-row{display:grid;grid-template-columns:1fr 1fr;gap:12px}
    label{display:grid;gap:6px;font-weight:700;font-size:.9rem}
    input,select,textarea{width:100%;min-width:0;font:inherit;padding:10px 11px;border:1px solid #aaa2ad;border-radius:2px;background:#fffdf7;color:#27243f}
    textarea{min-height:105px;resize:vertical}
    .booking-form .btn{justify-self:start}
    .form-status{min-height:1.5em;color:#514d5f;font-size:.9rem;font-weight:700}
    .form-status .status-check{position:absolute;top:50%;left:50%;z-index:2;display:grid;width:104px;height:104px;place-items:center;border-radius:50%;background:#34724a;color:#fff;box-shadow:0 8px 24px rgba(17,19,33,.3);opacity:0;pointer-events:none;transform:translate(-50%,-50%) scale(.35)}
    .form-status .status-check svg{width:60px;height:60px}
    .form-status .status-check path{stroke-dasharray:24;stroke-dashoffset:24}
    .form-status.is-success .status-check{animation:check-pop 1.35s ease-out forwards}
    .form-status.is-success .status-check path{animation:check-draw .4s .15s ease-out forwards}
    @keyframes check-pop{0%{opacity:0;transform:translate(-50%,-50%) scale(.35)}14%{opacity:1;transform:translate(-50%,-50%) scale(1.12)}28%,76%{opacity:1;transform:translate(-50%,-50%) scale(1)}100%{opacity:0;transform:translate(-50%,-50%) scale(.8)}}
    @keyframes check-draw{to{stroke-dashoffset:0}}
    .gifts{background:var(--olive)}
    .gift-grid{display:grid;grid-template-columns:1fr;max-width:820px;margin:0 auto}
    .gift-copy{text-align:center}
    .gift-copy h2{margin-top:8px;font-family:var(--serif);font-size:clamp(2.3rem,4vw,3.4rem);line-height:1.12}
    .gift-copy>p{margin:16px 0;color:var(--mute)}
    .gift-offer{max-width:560px;margin:28px auto 0;padding:28px;background:var(--pine);border:1px solid rgba(198,107,82,.6)}
    .gift-offer h3{font-family:var(--serif);font-size:1.65rem;line-height:1.2}
    .gift-offer p{margin-top:12px;color:var(--mute)}
    footer{padding:38px 0;background:var(--pine);color:var(--mute);border-top:1px solid rgba(198,107,82,.35);font-size:.95rem}
    footer .wrap{display:flex;justify-content:space-between;align-items:center;gap:20px;flex-wrap:wrap}
    .footer-note{font-size:.88rem}
    @media(max-width:860px){
      .hero .wrap{grid-template-columns:1fr;gap:38px}
      .hero-photo{min-height:360px;margin-right:14px}
      nav ul li:not(:last-child){display:none}
    }
    @media(max-width:560px){
      .wrap{padding:0 20px}
      nav{padding:20px 0}
      .hero{padding:58px 0 66px}
      section{padding:62px 0}
      .hero-photo{min-height:290px}
      .occasion-grid{grid-template-columns:1fr}
      .occasion-photo{height:240px}
      .form-row{grid-template-columns:1fr}
      .booking-form{padding:20px}
      .photo-note{right:-10px;max-width:195px}
      footer .wrap{align-items:flex-start;flex-direction:column}
    }
    @media(prefers-reduced-motion:reduce){html{scroll-behavior:auto}.form-status.is-success .status-check,.form-status.is-success .status-check path{animation:none}.form-status.is-success .status-check{position:static;display:inline-flex;width:auto;height:auto;margin-right:8px;background:none;color:#34724a;box-shadow:none;opacity:1;transform:none}.form-status.is-success .status-check svg{width:20px;height:20px}.form-status.is-success .status-check path{stroke-dashoffset:0}}
    @media(max-width:980px){
      nav{flex-wrap:wrap;padding:18px 0;gap:12px}
      nav ul{flex:1 1 100%;justify-content:center;flex-wrap:wrap;gap:8px clamp(12px,3vw,24px)}
      nav ul li:not(:last-child){display:list-item}
      nav ul a{display:flex;min-height:44px;align-items:center;padding:6px 4px}
      nav ul .btn{padding:10px 16px}
    }
    @media(max-width:560px){
      .wrap{padding-right:18px;padding-left:18px}
      .logo img{width:132px;height:88px}
      nav{padding:14px 0}
      nav ul{column-gap:12px;row-gap:2px}
      nav ul a{font-size:.84rem}
      h1{font-size:clamp(2.8rem,11vw,3.8rem);line-height:1.06}
      .hero{padding:52px 0 58px}
      section{padding:58px 0}
      .hero .wrap{gap:30px}
      .hero-photo{min-height:280px;margin-right:10px}
      .occasion-photo{height:220px}
      .occasion-copy{padding:19px 18px 22px}
      .form-row{grid-template-columns:1fr}
      .booking-form{padding:20px}
      .booking-form .btn{width:100%;min-height:46px}
      .gift-offer{padding:22px 18px}
      .photo-note{right:-10px;bottom:14px;padding:13px 15px}
      footer .wrap{align-items:flex-start;flex-direction:column}
    }
  </style>
</head>
<body>
  <header>
    <div class="wrap">
      <nav aria-label="Main navigation">
        <a class="logo" href="index.html"><img src="logo.png" alt="Savora Avenue logo"><span class="logo-part logo-smoke" aria-hidden="true"></span><span class="logo-part logo-utensils" aria-hidden="true"></span></a>
        <ul>
          <li><a href="index.html">Home</a></li>
          <li><a href="menu.html">Menu</a></li>
          <li><a href="occasions.html" aria-current="page">Occasions</a></li>
          <li><a href="about.html">About</a></li>
          <li><a class="btn" href="#vip-booking">Book a table</a></li>
        </ul>
      </nav>
    </div>
  </header>

  <main>
    <section class="hero" aria-labelledby="occasions-title">
      <div class="wrap">
        <div>
          <p class="eyebrow">Make it a moment</p>
          <h1 id="occasions-title">A little more special.</h1>
          <p class="hero-copy">From an intimate VIP dinner to a birthday shared around the table, celebrate your occasion with thoughtful details and generous food.</p>
          <div class="hero-actions">
            <a class="btn" href="#host">Plan your occasion</a>
            <a class="btn ghost" href="#gift-cards">Explore gift cards</a>
          </div>
        </div>
        <figure class="hero-photo">
          <img src="vipsit.jpg" alt="An elegant private dining table set for a special evening">
          <figcaption class="photo-note">Your own table, your own occasion.</figcaption>
        </figure>
      </div>
    </section>

    <section class="offerings" aria-labelledby="celebrate-title">
      <div class="wrap">
        <div class="section-heading">
          <p class="eyebrow">Celebrate together</p>
          <h2 class="section-title" id="celebrate-title">Good reasons to gather.</h2>
          <p>Let us help make the details feel easy, whether you are celebrating a birthday or bringing your favourite people together.</p>
        </div>
        <div class="occasion-grid">
          <article class="occasion-card">
            <figure class="occasion-photo">
              <img src="birth.jpg" alt="A festive birthday celebration with a special dessert">
            </figure>
            <div class="occasion-copy">
              <p class="eyebrow">Birthday specials</p>
              <h3>Make their day delicious.</h3>
              <p>Gather everyone for a birthday meal, add a celebratory dessert, and let us know whose day it is when you book. Birthday treats and arrangements can be confirmed with our team.</p>
              <a class="btn" href="#host">Plan a birthday</a>
            </div>
          </article>
          <article class="occasion-card">
            <figure class="occasion-photo">
              <img src="vipsit.jpg" alt="A reserved VIP dining table prepared for a private dinner">
            </figure>
            <div class="occasion-copy">
              <p class="eyebrow">VIP dining</p>
              <h3>A table set apart.</h3>
              <p>Request a special dinner table for your VIP guests. Share your preferred date, party size and any notes, and our team will follow up to discuss availability and personal touches.</p>
              <a class="btn" href="#vip-booking">Request a VIP table</a>
            </div>
          </article>
        </div>
      </div>
    </section>

    <section class="host" id="host" aria-labelledby="host-title">
      <div class="wrap">
        <div class="section-heading">
          <p class="eyebrow">Bring everyone together</p>
          <h2 class="section-title" id="host-title">Host a special occasion.</h2>
          <p>From milestone birthdays to family gatherings and intimate celebrations, tell us what you have in mind.</p>
        </div>
        <div class="host-grid">
          <div class="host-copy">
            <h3>Make room for a memorable meal.</h3>
            <p>We welcome special occasion enquiries for groups looking for a warm, personal dining experience. Send us your preferred date and the shape of your celebration; our team can help discuss the table and menu options.</p>
            <ul>
              <li>VIP dinner table requests</li>
              <li>Birthday dinners and celebratory dessert requests</li>
              <li>Family gatherings and other special occasions</li>
            </ul>
          </div>
          <form class="booking-form" id="vip-booking">
            <h3>Request a VIP table</h3>
            <p class="form-intro">Share your details and we will follow up to confirm availability.</p>
            <div class="form-row">
              <label>Name<input name="name" type="text" autocomplete="name" required></label>
              <label>Email<input name="email" type="email" autocomplete="email" required></label>
            </div>
            <div class="form-row">
              <label>Occasion
                <select name="occasion" required>
                  <option value="">Choose an occasion</option>
                  <option>VIP dinner</option>
                  <option>Birthday</option>
                  <option>Family gathering</option>
                  <option>Other special occasion</option>
                </select>
              </label>
              <label>Guests
                <select name="guests" required>
                  <option value="">Choose party size</option>
                  <option>1-2 guests</option>
                  <option>3-4 guests</option>
                  <option>5-8 guests</option>
                  <option>9 or more guests</option>
                </select>
              </label>
            </div>
            <div class="form-row">
              <label>Preferred date<input name="date" type="date" required></label>
              <label>Preferred time<input name="time" type="time" required></label>
            </div>
            <label>Notes or requests<textarea name="notes" placeholder="Tell us about your celebration or any special requests."></textarea></label>
            <button class="btn" type="submit">Send booking request</button>
            <p class="form-status" id="booking-status" role="status" aria-live="polite"><span class="status-check" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none"><path d="m5 12 4 4L19 6" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"></path></svg></span><span class="status-message"></span></p>
          </form>
        </div>
      </div>
    </section>

    <section class="gifts" id="gift-cards" aria-labelledby="gift-title">
      <div class="wrap gift-grid">
        <div class="gift-copy">
          <p class="eyebrow">A meal, sent with love</p>
          <h2 id="gift-title">A little thank-you for a generous meal.</h2>
          <div class="gift-offer">
            <h3>Spend more than R1,000</h3>
            <p>Customers who spend over R1,000 receive a digital gift card. Our team will confirm your qualifying spend and issue your card; ask us for the current gift-card value.</p>
          </div>
        </div>
      </div>
    </section>
  </main>

  <footer>
    <div class="wrap">
      <a class="logo" href="index.html"><img src="logo.png" alt="Savora Avenue logo"><span class="logo-part logo-smoke" aria-hidden="true"></span><span class="logo-part logo-utensils" aria-hidden="true"></span></a>
      <p class="footer-note">Different kitchens. One table.</p>
    </div>
  </footer>

  <script>
    document.getElementById('vip-booking').addEventListener('submit', function(event){
      event.preventDefault();
      var status = document.getElementById('booking-status');
      status.classList.remove('is-success');
      void status.offsetWidth;
      status.classList.add('is-success');
      status.querySelector('.status-message').textContent =
        'Your request is ready. Our team will follow up to confirm availability.';
    });
  </script>
</body>
</html>
